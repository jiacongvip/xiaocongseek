# Windows 未签名测试包配置（本地测试用，勿提交）
# 由 macOS 侧预先填好；Windows 上若 --check 报字段错误，按提示改这里

# 应用标识（与 macOS 包一致）
DSH_DESKTOP_APP_ID=com.xiaocong.seek

# 更新通道：test（决定读取的强制更新 origin）
DSH_DESKTOP_AUTO_UPDATE_ENV=test

# 强制更新策略服务 origin（必须是纯 HTTPS origin，不能带路径/查询）
DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=https://xiaocongapi.azheteng.cn
DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=https://xiaocongapi.azheteng.cn

# 策略选项：test 环境要求 allowedAuthOrigins 非空
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://xiaocongapi.azheteng.cn"]}'

# 下载源（测试 release 用，可留空；仅正式上传需要）
DOWNLOAD_TEST_ORIGIN=
DOWNLOAD_TEST_RELEASE_ID=

# Windows 安装器压缩等级
DSH_DESKTOP_WINDOWS_COMPRESSION_LEVEL=3

# 签名相关：未签名构建不读取，保持空
DSH_DESKTOP_WINDOWS_CER_FILE=
DSH_DESKTOP_WINDOWS_SIGNTOOL=
DSH_DESKTOP_WINDOWS_KEY_CONTAINER=
DSH_DESKTOP_WINDOWS_TOKEN_PIN=
