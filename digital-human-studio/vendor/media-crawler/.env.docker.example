# 复制为项目根目录 .env 后再 docker compose up：
#   cp .env.docker.example .env
#
# 必填：随机长字符串，保护 /api/crawler /api/tasks /api/data 等接口
MEDIA_CRAWLER_API_KEY=replace-with-a-long-random-secret

# 可选：与 compose 中 environment 一致即可，一般不用改
# MEDIA_CRAWLER_DATA_DIR=/app/data
# MEDIA_CRAWLER_TASK_DB=/app/data/tasks.db

# 以下为业务库/代理，按需从 .env.example 拷贝，不要提交真实密码
# MYSQL_DB_HOST=
# REDIS_DB_HOST=
# KDL_SECERT_ID=

# Developer portal (SQLite). Default: $MEDIA_CRAWLER_DATA_DIR/portal.db
# MEDIA_CRAWLER_PORTAL_DB=/app/data/portal.db
#
# MEDIA_CRAWLER_API_KEY 仍作为 Master Key（可调用全部 /api/tasks，并看全部任务）
# 门户用户通过注册创建账号，再在 /portal 生成自己的 API Key
