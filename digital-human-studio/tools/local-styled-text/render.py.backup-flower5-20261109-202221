#!/usr/bin/env python3
"""Offline local styled Chinese text renderer (no VectCut cloud / effect_effect_id).

Renders transparent PNG with self-owned style presets.
Uses system/open fonts only. Never fetches paid CapCut flower-text packs.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

from PIL import Image, ImageDraw, ImageFilter, ImageFont

