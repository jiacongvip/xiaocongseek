# Local New API (docker-compose) — copy to .env and change passwords before any non-local use.
# Asia/Shanghai already set in compose.

NEW_API_PORT=3000
POSTGRES_USER=root
POSTGRES_PASSWORD=change_me_local
POSTGRES_DB=new-api
REDIS_PASSWORD=change_me_local

# Optional: multi-node session secret (set if you scale later)
# SESSION_SECRET=replace_with_long_random_string

# Harness / digital-human-studio will use these (not loaded by New API itself):
HARNESS_NEWAPI_BASE_URL=http://127.0.0.1:3000
# Create a user token in New API console after first login; paste here for local smoke tests only.
HARNESS_NEWAPI_TOKEN=
